# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# Which LLM backend the agent uses: anthropic | openai | google | openrouter
LLM_PROVIDER=anthropic
# Model ID for that provider (default shown is for anthropic)
LLM_MODEL=claude-opus-5-5

# Only the key for the provider you selected is required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Claude only: reasoning effort (low | medium | high | xhigh). See evals/FAILURES.md.
LLM_EFFORT=medium

# Web app only: questions allowed per browser session (0 = unlimited).
# Set this on any public deployment to bound API costs.
MC_SESSION_QUESTION_LIMIT=0

# Optional: LangSmith tracing (observability). Leave blank to disable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=maintenance-copilot
